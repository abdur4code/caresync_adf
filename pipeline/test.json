							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"headers": {
						"Authorization": {
							"value": "@concat(\n    'Bearer ',\n    activity('Get_Databricks_PAT').output.value\n)",
							"type": "Expression"
						},
						"Accept": "application/json"
					},
					"url": {
						"value": "@concat(\n  'https://adb-7405616476980002.2.azuredatabricks.net/api/2.2/jobs/runs/get?run_id=249243301061409'\n)",
						"type": "Expression"
					}
				}
			},
			{
